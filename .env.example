# Copy to .env. Everything has a safe default.
MOCK_LLM=true                 # true = no language model needed (rules + templates). false = use Ollama for wording only
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
DB_PATH=data/train.db
DATA_ANCHOR=2026-11-21        # the "today" the generated seat data is built around
# DEMO_NOW=2026-11-21T10:00:00+05:30   # pin the clock for the whole service (demo / testing)
PROTECT_ADMIN=false           # true = /ingest and /admin/reset_demo need header X-Admin-Key
ADMIN_KEY=change-me
RATE_LIMIT_PER_MIN=300
DEMO=true                     # false hides the demo passenger list
